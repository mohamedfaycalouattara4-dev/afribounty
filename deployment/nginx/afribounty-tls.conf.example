# Exemple à installer après remplacement des chemins de certificats et du nom DNS.
# Le fichier n’est pas activé automatiquement : la validation du certificat relève de l’infrastructure.
upstream afribounty_asgi {
    server 127.0.0.1:8000;
    keepalive 32;
}

server {
    listen 443 ssl http2;
    server_name app.example.bf;

    ssl_certificate /etc/letsencrypt/live/app.example.bf/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.example.bf/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:TLS:10m;
    ssl_session_tickets off;

    client_max_body_size 10m;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;

    location /private-media/ {
        return 404;
    }

    location / {
        proxy_pass http://afribounty_asgi;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Correlation-ID $request_id;
        proxy_read_timeout 60s;
        proxy_buffering on;
    }
}
