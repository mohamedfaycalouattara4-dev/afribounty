# Copier vers .env.production hors du dépôt, puis remplacer chaque valeur d’exemple.
AFRIBOUNTY_ENVIRONMENT=production
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=generate-a-random-secret-of-at-least-50-characters
DJANGO_ALLOWED_HOSTS=app.example.bf
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.bf
AFRIBOUNTY_AUTH_RP_ID=app.example.bf
AFRIBOUNTY_AUTH_ORIGIN=https://app.example.bf
DJANGO_CORS_ALLOWED_ORIGINS=
DJANGO_DATABASE_URL=postgresql://afribounty:change-me@postgres:5432/afribounty
# Compose isolé : redis:// sur le réseau interne ; préférer rediss:// avec Redis managé/TLS.
DJANGO_REDIS_URL=redis://:change-me@redis:6379/0
IDENTITY_TOTP_FERNET_KEY=generate-a-valid-fernet-key
EVIDENCE_ENCRYPTION_KEY=generate-a-distinct-valid-fernet-key
AFRIBOUNTY_EVIDENCE_STORAGE_BACKEND=private-object
EVIDENCE_SCAN_REQUIRED=1
METRICS_AUTH_TOKEN=generate-a-distinct-random-token-of-at-least-32-characters
AUDIT_INTEGRITY_KEY=generate-a-distinct-random-audit-signing-key-of-at-least-32-characters
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Variables d’infrastructure, jamais à committer.
POSTGRES_PASSWORD=generate-a-random-database-password
REDIS_PASSWORD=generate-a-random-redis-password
